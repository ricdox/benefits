<style>
:root {
  --p: #4e2096; --pd: #411d72; --pl: #7b4eb9; --pul: #ede5f7; --pul2: #f5f0fc;
  --acc: #ffa840; --accl: #fff4e0;
  --bg: #f3eee8; --bgl: #fbf9f7; --w: #fff;
  --g1: #f2f2f2; --g2: #e6e6e6; --g3: #d9d9d9; --g5: #9e9e9e; --g7: #616161; --g9: #1a1a1a;
  --ok: #49A971; --okl: #e8f5e9;
  --wa: #FFA840; --wal: #fff4e0;
  --er: #EA534A; --erl: #ffebee;
  --sh: 0 4px 16px rgba(78,32,150,.08), 0 2px 6px rgba(0,0,0,.05);
  --shsm: 0 1px 4px rgba(0,0,0,.07);
  --r: 12px; --rsm: 8px;
}
* { margin: 0; padding: 0; box-sizing: border-box; }
body { font-family: 'Inter', -apple-system, sans-serif; background: var(--bg); color: var(--g9); min-height: 100vh; font-size: 14px; line-height: 1.5; }

/* HEADER */
.hdr { background: var(--pd); color: #fff; position: sticky; top: 0; z-index: 200; box-shadow: 0 2px 12px rgba(65,29,114,.25); }
.hdr-in { display: flex; align-items: center; justify-content: space-between; padding: 10px 28px; max-width: 1400px; margin: 0 auto; }
.logo { display: flex; align-items: center; gap: 10px; }
.logo-icon { width: 34px; height: 34px; border-radius: 8px; background: rgba(255,255,255,.15); display: flex; align-items: center; justify-content: center; font-size: 18px; }
.logo-text .brand { font-size: 15px; font-weight: 800; letter-spacing: -.2px; line-height: 1; }
.logo-text .sub { font-size: 11px; opacity: .6; margin-top: 1px; }
.hdr-sep { width: 1px; height: 22px; background: rgba(255,255,255,.18); margin: 0 12px; }
.hdr-title { font-size: 12.5px; font-weight: 500; opacity: .7; letter-spacing: .2px; }
.hdr-badge { background: var(--acc); color: #fff; font-size: 11px; font-weight: 700; padding: 3px 10px; border-radius: 20px; }

/* NAV TABS */
.nav-tabs { background: var(--w); border-bottom: 2px solid var(--pul); position: sticky; top: 54px; z-index: 150; box-shadow: 0 2px 8px rgba(0,0,0,.05); }
.nav-tabs-inner { display: flex; padding: 0 28px; max-width: 1400px; margin: 0 auto; overflow-x: auto; }
.nav-tab { padding: 12px 18px; font-size: 12.5px; font-weight: 600; color: var(--g5); border-bottom: 3px solid transparent; cursor: pointer; white-space: nowrap; transition: all .2s; display: flex; align-items: center; gap: 7px; margin-bottom: -2px; user-select: none; }
.nav-tab:hover { color: var(--p); background: var(--pul2); }
.nav-tab.active { color: var(--p); border-bottom-color: var(--p); }
.tab-badge { background: var(--acc); color: #fff; font-size: 10px; font-weight: 700; padding: 1px 7px; border-radius: 10px; }
.tab-badge.green { background: var(--ok); }
.tab-badge.blue { background: var(--pl); }

/* MAIN */
.main { max-width: 1400px; margin: 0 auto; padding: 28px 28px 80px; }

/* SECTION */
.sec-ttl { font-size: 11.5px; font-weight: 700; text-transform: uppercase; letter-spacing: .8px; color: var(--p); display: flex; align-items: center; gap: 8px; margin: 28px 0 14px; }
.sec-ttl:first-child { margin-top: 0; }
.sec-ttl::before { content: ''; width: 4px; height: 15px; background: var(--acc); border-radius: 2px; flex-shrink: 0; }
.sec-line { flex: 1; height: 1px; background: linear-gradient(90deg, var(--g2) 0%, transparent 100%); margin-left: 4px; }

/* KPIs */
.kpi-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 14px; margin-bottom: 28px; }
.kpi { background: var(--w); border-radius: var(--r); padding: 18px 18px 14px; box-shadow: var(--shsm); border: 1px solid rgba(78,32,150,.06); position: relative; overflow: hidden; transition: transform .15s, box-shadow .15s; cursor: default; }
.kpi:hover { transform: translateY(-2px); box-shadow: var(--sh); }
.kpi::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px; border-radius: var(--r) var(--r) 0 0; }
.kpi.c0::before { background: var(--p); }
.kpi.c1::before { background: var(--ok); }
.kpi.c2::before { background: var(--acc); }
.kpi.c3::before { background: var(--pl); }
.kpi.c4::before { background: var(--er); }
.kpi-lbl { font-size: 10.5px; font-weight: 600; color: var(--g5); text-transform: uppercase; letter-spacing: .5px; margin-bottom: 6px; }
.kpi-val { font-size: 26px; font-weight: 800; letter-spacing: -.5px; line-height: 1; color: var(--g9); }
.kpi-sub { font-size: 11px; color: var(--g5); margin-top: 5px; }

/* TOOLBAR */
.toolbar { display: flex; align-items: center; gap: 10px; margin-bottom: 14px; flex-wrap: wrap; }
.search-wrap { position: relative; flex: 1; min-width: 200px; max-width: 360px; }
.search-wrap input { width: 100%; padding: 8px 12px 8px 34px; border: 1.5px solid var(--g3); border-radius: var(--rsm); font-size: 13px; font-family: inherit; outline: none; transition: border-color .2s; background: var(--w); }
.search-wrap input:focus { border-color: var(--p); }
.search-icon { position: absolute; left: 10px; top: 50%; transform: translateY(-50%); color: var(--g5); font-size: 14px; pointer-events: none; }
.filter-select { padding: 8px 12px; border: 1.5px solid var(--g3); border-radius: var(--rsm); font-size: 12.5px; font-family: inherit; outline: none; background: var(--w); color: var(--g9); cursor: pointer; transition: border-color .2s; }
.filter-select:focus { border-color: var(--p); }
.result-count { font-size: 12px; color: var(--g5); font-weight: 500; margin-left: auto; white-space: nowrap; }

/* TABLE */
.tbl-wrap { border-radius: var(--r); overflow: hidden; box-shadow: var(--shsm); border: 1px solid rgba(78,32,150,.06); background: var(--w); }
.tbl-scroll { overflow-x: auto; }
.tbl { width: 100%; border-collapse: collapse; font-size: 13px; }
.tbl th { background: var(--pd); color: #fff; padding: 10px 14px; text-align: left; font-weight: 600; font-size: 11.5px; letter-spacing: .3px; white-space: nowrap; cursor: pointer; user-select: none; transition: background .15s; }
.tbl th:hover { background: #371a60; }
.tbl th.sorted-asc::after { content: ' ↑'; opacity: .7; }
.tbl th.sorted-desc::after { content: ' ↓'; opacity: .7; }
.tbl td { padding: 10px 14px; border-bottom: 1px solid var(--g2); vertical-align: middle; }
.tbl tr:last-child td { border-bottom: none; }
.tbl tr:hover td { background: #faf8fd; }
.tbl-empty { text-align: center; color: var(--g5); padding: 48px 20px !important; font-size: 13px; }

/* BADGES */
.badge { display: inline-block; padding: 2px 8px; border-radius: 10px; font-size: 11px; font-weight: 600; white-space: nowrap; }
.badge-ok { background: var(--okl); color: var(--ok); }
.badge-p { background: var(--pul); color: var(--p); }
.badge-acc { background: var(--accl); color: #a06010; }
.badge-b { background: var(--g1); color: var(--g7); }
.badge-blue { background: #e3f2fd; color: #1565c0; }
.badge-green { background: var(--okl); color: #2e7d32; }

/* CHART BAR */
.chart-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 28px; }
.ccard { background: var(--w); border-radius: var(--r); padding: 20px; box-shadow: var(--shsm); border: 1px solid rgba(78,32,150,.06); }
.ccard-title { font-size: 12px; font-weight: 700; color: var(--p); text-transform: uppercase; letter-spacing: .6px; margin-bottom: 16px; display: flex; align-items: center; gap: 6px; }
.ccard-title::before { content: ''; width: 3px; height: 12px; background: var(--acc); border-radius: 2px; }
.bar-row { display: flex; align-items: center; gap: 10px; margin-bottom: 10px; }
.bar-label { font-size: 12px; color: var(--g7); width: 120px; flex-shrink: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.bar-track { flex: 1; height: 10px; background: var(--g1); border-radius: 5px; overflow: hidden; }
.bar-fill { height: 100%; border-radius: 5px; transition: width .6s cubic-bezier(.4,0,.2,1); }
.bar-val { font-size: 12px; font-weight: 700; color: var(--g9); width: 28px; text-align: right; }

/* SECTION PANEL */
.section-panel { display: none; }
.section-panel.active { display: block; }

/* PAGINATION */
.pagination { display: flex; align-items: center; justify-content: flex-end; gap: 6px; padding: 12px 16px; border-top: 1px solid var(--g2); background: var(--w); }
.page-btn { background: none; border: 1.5px solid var(--g3); color: var(--g7); border-radius: var(--rsm); padding: 4px 10px; font-size: 12px; font-weight: 600; cursor: pointer; font-family: inherit; transition: all .15s; }
.page-btn:hover:not(:disabled) { border-color: var(--p); color: var(--p); }
.page-btn.active { background: var(--p); border-color: var(--p); color: #fff; }
.page-btn:disabled { opacity: .4; cursor: not-allowed; }
.page-info { font-size: 12px; color: var(--g5); margin-right: 4px; }

/* FOOTER */
.footer { position: fixed; bottom: 0; left: 0; right: 0; background: var(--w); border-top: 1px solid var(--g2); padding: 8px 28px; font-size: 11px; color: var(--g5); text-align: center; z-index: 100; }

/* RESPONSIVE */
@media (max-width: 768px) {
  .hdr-in { padding: 10px 16px; }
  .main { padding: 16px 16px 80px; }
  .nav-tabs-inner { padding: 0 16px; }
  .chart-grid { grid-template-columns: 1fr; }
  .kpi-grid { grid-template-columns: repeat(2, 1fr); }
  .bar-label { width: 80px; font-size: 11px; }
}

/* ANIMATE */
@keyframes fadeUp { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
.section-panel.active { animation: fadeUp .25s ease; }
.kpi { animation: fadeUp .3s ease both; }
.kpi:nth-child(1) { animation-delay: .05s; }
.kpi:nth-child(2) { animation-delay: .1s; }
.kpi:nth-child(3) { animation-delay: .15s; }
.kpi:nth-child(4) { animation-delay: .2s; }
.kpi:nth-child(5) { animation-delay: .25s; }
</style>
