// ============================================================
// STATE
// ============================================================
const state = {
  pets: { data: DATA.Petsupermarket, filtered: [...DATA.Petsupermarket], sort: { col: -1, dir: 1 }, page: 1, perPage: 15 },
  tec:  { data: DATA.Tecnologia,    filtered: [...DATA.Tecnologia],    sort: { col: -1, dir: 1 }, page: 1, perPage: 15 },
  prov: { data: DATA.Provet,        filtered: [...DATA.Provet],        sort: { col: -1, dir: 1 }, page: 1, perPage: 15 },
};

// ============================================================
// BADGES
// ============================================================
function badgeModalidade(v) {
  if (!v) return v;
  if (v === 'Híbrido')   return `<span class="badge badge-acc">${v}</span>`;
  if (v === 'Remoto')    return `<span class="badge badge-blue">${v}</span>`;
  if (v === 'Presencial') return `<span class="badge badge-b">${v}</span>`;
  return v;
}
function badgeTurno(v) {
  if (!v) return v;
  return `<span class="badge badge-p">${v}</span>`;
}
function badgeSituacao(v) {
  return `<span class="badge badge-ok">${v}</span>`;
}

// ============================================================
// RENDER TABLE
// ============================================================
function renderTable(key) {
  const s = state[key];
  const tbody = document.getElementById(`tbody-${key}`);
  const total = s.filtered.length;
  const start = (s.page - 1) * s.perPage;
  const end   = Math.min(start + s.perPage, total);
  const slice = s.filtered.slice(start, end);

  // Count
  const countEl = document.getElementById(`count-${key}`);
  if (countEl) countEl.textContent = `${total} resultado${total !== 1 ? 's' : ''}`;

  if (slice.length === 0) {
    tbody.innerHTML = `<tr><td colspan="9" class="tbl-empty">Nenhum resultado encontrado</td></tr>`;
  } else {
    tbody.innerHTML = slice.map(row => `
      <tr>
        <td style="font-size:12px;color:var(--g5);font-family:monospace">${row[0]}</td>
        <td style="font-weight:600">${row[1]}</td>
        <td>${row[2]}</td>
        <td style="color:var(--g5)">${row[3]}</td>
        <td>${row[4]}</td>
        <td>${badgeTurno(row[5])}</td>
        <td>${row[6]}</td>
        <td>${badgeModalidade(row[7])}</td>
        <td>${badgeSituacao(row[8])}</td>
      </tr>
    `).join('');
  }

  // Pagination (only for pets)
  const pagEl = document.getElementById(`pag-${key}`);
  if (pagEl) {
    const pages = Math.ceil(total / s.perPage);
    if (pages <= 1) { pagEl.innerHTML = ''; return; }
    let html = `<span class="page-info">Pág. ${s.page} de ${pages}</span>`;
    html += `<button class="page-btn" onclick="goPage('${key}',${s.page-1})" ${s.page===1?'disabled':''}>‹</button>`;
    for (let i = 1; i <= pages; i++) {
      if (i===1 || i===pages || Math.abs(i-s.page)<=1) {
        html += `<button class="page-btn ${i===s.page?'active':''}" onclick="goPage('${key}',${i})">${i}</button>`;
      } else if (Math.abs(i-s.page)===2) {
        html += `<span style="color:var(--g5);font-size:12px">…</span>`;
      }
    }
    html += `<button class="page-btn" onclick="goPage('${key}',${s.page+1})" ${s.page===pages?'disabled':''}>›</button>`;
    pagEl.innerHTML = html;
  }
}

function goPage(key, page) {
  const s = state[key];
  const pages = Math.ceil(s.filtered.length / s.perPage);
  s.page = Math.max(1, Math.min(pages, page));
  renderTable(key);
}

// ============================================================
// FILTER
// ============================================================
function filterTable(key) {
  const s = state[key];
  const searchEl = document.getElementById(`search-${key}`);
  const q = searchEl ? searchEl.value.toLowerCase() : '';

  const locEl  = document.getElementById(`filter-${key}-localidade`);
  const modEl  = document.getElementById(`filter-${key}-modalidade`);
  const locVal = locEl ? locEl.value : '';
  const modVal = modEl ? modEl.value : '';

  s.filtered = s.data.filter(row => {
    const matchQ = !q || [row[0],row[1],row[6]].some(v => String(v).toLowerCase().includes(q));
    const matchL = !locVal || row[6] === locVal;
    const matchM = !modVal || row[7] === modVal;
    return matchQ && matchL && matchM;
  });

  s.page = 1;
  renderTable(key);
}

// ============================================================
// SORT
// ============================================================
function sortTable(key, col) {
  const s = state[key];
  if (s.sort.col === col) s.sort.dir *= -1;
  else { s.sort.col = col; s.sort.dir = 1; }
  s.filtered.sort((a, b) => {
    const va = String(a[col] ?? '').toLowerCase();
    const vb = String(b[col] ?? '').toLowerCase();
    return va < vb ? -s.sort.dir : va > vb ? s.sort.dir : 0;
  });
  renderTable(key);
}

// ============================================================
// TABS
// ============================================================
function showTab(name) {
  document.querySelectorAll('.section-panel').forEach(p => p.classList.remove('active'));
  document.querySelectorAll('.nav-tab').forEach(t => t.classList.remove('active'));
  document.getElementById(`tab-${name}`).classList.add('active');
  event.currentTarget.classList.add('active');
}

// ============================================================
// CHARTS
// ============================================================
function countBy(arr, col) {
  const map = {};
  arr.forEach(r => { const v = r[col]; map[v] = (map[v]||0) + 1; });
  return Object.entries(map).sort((a,b) => b[1]-a[1]);
}

const COLORS = ['#4e2096','#7b4eb9','#ffa840','#49A971','#EA534A','#1565c0','#e65100','#558b2f'];

function renderBarChart(containerId, entries, total) {
  const el = document.getElementById(containerId);
  if (!el) return;
  el.innerHTML = entries.map(([label, count], i) => `
    <div class="bar-row">
      <div class="bar-label" title="${label}">${label}</div>
      <div class="bar-track">
        <div class="bar-fill" style="width:${(count/total*100).toFixed(1)}%;background:${COLORS[i%COLORS.length]}"></div>
      </div>
      <div class="bar-val">${count}</div>
    </div>
  `).join('');
}

function buildCharts() {
  const all = [...DATA.Petsupermarket, ...DATA.Tecnologia, ...DATA.Provet];
  renderBarChart('chart-localidade', countBy(all, 6), all.length);
  renderBarChart('chart-modalidade', countBy(all, 7), all.length);
  renderBarChart('chart-turno',      countBy(all, 5), all.length);
  renderBarChart('chart-empresa',    countBy(all, 4), all.length);
}

// ============================================================
// POPULATE FILTERS
// ============================================================
function buildFilters() {
  function opts(key, col, data) {
    const el = document.getElementById(`filter-${key}-${col}`);
    if (!el) return;
    const vals = [...new Set(data.map(r => r[col === 'localidade' ? 6 : 7]))].sort();
    vals.forEach(v => { const o = document.createElement('option'); o.value = v; o.textContent = v; el.appendChild(o); });
  }
  opts('pets', 'localidade', DATA.Petsupermarket);
  opts('pets', 'modalidade', DATA.Petsupermarket);
  opts('prov', 'modalidade', DATA.Provet);
}

// ============================================================
// INIT
// ============================================================
buildCharts();
buildFilters();
renderTable('pets');
renderTable('tec');
renderTable('prov');
</script>
